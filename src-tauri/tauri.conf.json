{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BritSheet",
  "version": "0.1.0",
  "identifier": "com.britsheet.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BritSheet",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "BritSheet – professional spreadsheet",
    "longDescription": "BritSheet is a feature-complete desktop spreadsheet application built with Tauri, Rust and React.",
    "category": "Productivity",
    "resources": [
      "WebView2Loader.dll"
    ],
    "fileAssociations": [
      {
        "ext": ["britsheet"],
        "name": "BritSheet Workbook",
        "description": "BritSheet native workbook",
        "mimeType": "application/json",
        "role": "Editor"
      }
    ]
  }
}